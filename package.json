{
  "name": "wj-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:content": "node scripts/check-content.mjs",
    "check:prompts": "node scripts/check-prompts.mjs",
    "test:keywords": "node --test --test-concurrency=2 scripts/keyword-system/*.test.mjs",
    "keywords:brief": "node scripts/keyword-system/brief.mjs",
    "keywords:auto": "node scripts/keyword-system/auto-discover.mjs",
    "keywords:draft": "node scripts/keyword-system/draft.mjs",
    "keywords:batch-draft": "node scripts/keyword-system/persona-batch.mjs",
    "keywords:auto-publish": "node scripts/keyword-system/auto-publish.mjs",
    "check:writing": "node scripts/check-writing.mjs",
    "auto:eval": "node scripts/run-evals.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test:worker": "node --test worker/*.test.mjs",
    "test:neon": "node --test scripts/neon/*.test.mjs",
    "neon:migrate": "node scripts/neon/migrate.mjs",
    "neon:sync": "node scripts/neon/sync.mjs",
    "neon:sync:check": "node scripts/neon/sync.mjs --dry-run",
    "auto:write": "node scripts/auto-publish/auto-write.mjs",
    "auto:improve": "node scripts/auto-publish/prompt-improve.mjs",
    "verify": "node scripts/verify/run.mjs",
    "test:verify": "node --test scripts/verify/*.test.mjs",
    "image": "node scripts/auto-publish/generate-image.mjs",
    "admin": "node scripts/admin-server.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^7.3.1",
    "yaml": "^2.9.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
