---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicPosts } from '../lib/posts';
import { categoryPath, formatKoDate, toIsoDate } from '../lib/format';

const posts = await getPublicPosts();
const categories = Array.from(new Set(posts.map((post) => post.data.topic)));
const featuredPost = posts[0];
const latestPosts = featuredPost ? posts.slice(1, 7) : posts.slice(0, 7);
const readMinutes = (post: (typeof posts)[number]) => Math.max(1, Math.ceil((post.body ?? '').replace(/\s/g, '').length / 700));
const siteUrl = import.meta.env.SITE ?? Astro.site?.toString() ?? 'http://localhost:4321';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WJ Blog',
  description: '관심 있는 주제를 기록하고 나누는 개인 블로그',
  url: new URL('/', siteUrl).toString(),
  inLanguage: 'ko',
};
---
<BaseLayout
  title="WJ Blog — 개인 블로그"
  description="관심 있는 주제를 기록하고 나누는 개인 블로그입니다."
  jsonLd={jsonLd}
>
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title">WJ Blog</h1>
    <p class="home-intro-copy">
      관심 있는 주제를 기록하고 나누는 개인 블로그입니다.
      그때그때 배우고 경험한 것들을 주제 제한 없이 남깁니다.
    </p>
    <div class="home-intro-links">
      <a href="/categories">카테고리 둘러보기</a>
      <a href="/about">소개</a>
      <a href="/search">검색</a>
    </div>
  </section>

  {featuredPost && (
    <section class="home-featured-section" aria-labelledby="featured-heading">
      <div class="section-heading">
        <h2 id="featured-heading">최근 글</h2>
        <a class="section-link" href="/categories">카테고리별로 보기 <span aria-hidden="true">→</span></a>
      </div>
      <article class="post-card post-card--featured">
        {featuredPost.data.image && (
          <a class="post-card-image" href={`/posts/${featuredPost.id}`} tabIndex={-1} aria-hidden="true">
            <img src={featuredPost.data.image} alt="" width="720" height="480" loading="eager" />
          </a>
        )}
        <div class="post-card-body">
          <p class="post-card-meta">
            <a class="badge badge--topic" href={categoryPath(featuredPost.data.topic)}>{featuredPost.data.topic}</a>
            <time datetime={toIsoDate(featuredPost.data.pubDate)}>{formatKoDate(featuredPost.data.pubDate)}</time>
            <span>{readMinutes(featuredPost)}분 읽기</span>
          </p>
          <h3><a href={`/posts/${featuredPost.id}`}>{featuredPost.data.title}</a></h3>
          <p>{featuredPost.data.description}</p>
        </div>
      </article>
    </section>
  )}

  <section class="home-latest" aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">글 목록</h2>
      <a class="section-link" href="/search">전체 글 검색 <span aria-hidden="true">→</span></a>
    </div>
    {latestPosts.length ? (
      <ul class="post-list">
        {latestPosts.map((post) => (
          <li class="post-list-item">
            <p class="post-card-meta">
              <a class="badge badge--topic" href={categoryPath(post.data.topic)}>{post.data.topic}</a>
              <time datetime={toIsoDate(post.data.pubDate)}>{formatKoDate(post.data.pubDate)}</time>
              <span>{readMinutes(post)}분 읽기</span>
            </p>
            <h3><a href={`/posts/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="archive-empty archive-empty--home">
        <span class="empty-index" aria-hidden="true">—</span>
        <div><p class="empty-title">아직 공개된 글이 없습니다.</p><p>글이 공개되면 이 목록에서 확인할 수 있습니다.</p></div>
      </div>
    )}
  </section>

  <section class="home-categories" aria-labelledby="categories-heading">
    <div class="section-heading">
      <h2 id="categories-heading">카테고리</h2>
      <a class="section-link" href="/categories">모든 카테고리 <span aria-hidden="true">→</span></a>
    </div>
    {categories.length ? (
      <ul class="category-chip-list">
        {categories.map((category) => (
          <li>
            <a class="category-chip" href={categoryPath(category)}>
              {category}<small>{posts.filter((post) => post.data.topic === category).length}</small>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="home-categories-empty">글이 공개되면 카테고리가 자동으로 만들어집니다.</p>
    )}
    <p class="home-about-note">
      이 블로그에 대해 궁금하다면 <a href="/about">소개 페이지</a>에서 기록 방식을 읽어 볼 수 있습니다.
    </p>
  </section>
</BaseLayout>
