---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicPosts } from '../lib/posts';
import { categoryPath, formatKoDate, toIsoDate, topicBadgeClass, topicLabel } from '../lib/format';

const posts = await getPublicPosts();
const categories = Array.from(new Set(posts.map((post) => post.data.topic)));
const cardId = (slug: string) => `post-${slug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const siteUrl = import.meta.env.SITE ?? Astro.site?.toString() ?? 'http://localhost:4321';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WJ Blog',
  description: '관심 있는 주제를 기록하고 나누는 개인 블로그',
  url: new URL('/', siteUrl).toString(),
  inLanguage: 'ko',
};
---
<BaseLayout
  title="WJ Blog — 개인 블로그"
  description="관심 있는 주제를 기록하고 나누는 개인 블로그입니다."
  jsonLd={jsonLd}
>
  <section class="blog-intro" aria-labelledby="home-title">
    <p class="eyebrow">WJ Blog</p>
    <h1 id="home-title">관심 있는 것들을<br />기록합니다.</h1>
    <p>업무도구, 공부, 리뷰, 일상처럼 지금 남기고 싶은 이야기를 한 곳에 모읍니다.</p>
  </section>

  <div class="blog-layout">
    <section class="blog-feed" aria-labelledby="latest-heading">
      <div class="feed-heading">
        <h2 id="latest-heading">최근 글</h2>
        <a href="/search">글 검색</a>
      </div>
      {posts.length ? (
        <ul class="post-grid">
          {posts.map((post) => (
            <li class="post-card" aria-labelledby={cardId(post.id)}>
              {post.data.image && <img src={post.data.image} alt="" width="720" height="480" loading="lazy" />}
              <div class="post-card-body">
                <p class="post-meta">
                  <a class={topicBadgeClass(post.data.topic)} href={categoryPath(post.data.topic)}>{topicLabel(post.data.topic)}</a>
                  {post.data.testedAt && <span class="badge badge--verified">직접 확인</span>}
                </p>
                <h3 id={cardId(post.id)}><a href={`/posts/${post.id}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <time datetime={toIsoDate(post.data.pubDate)}>{formatKoDate(post.data.pubDate)}</time>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p><strong>아직 공개된 글이 없습니다.</strong></p>
          <p>첫 글을 준비 중입니다. 글이 공개되면 이곳에서 바로 읽을 수 있습니다.</p>
        </div>
      )}
    </section>

    <aside class="blog-sidebar" aria-label="블로그 사이드바">
      <section class="sidebar-section">
        <h2>카테고리</h2>
        {categories.length ? (
          <ul class="sidebar-topic-list">
            {categories.map((category) => (
              <li><a href={categoryPath(category)}><strong>{topicLabel(category)}</strong><span>{posts.filter((post) => post.data.topic === category).length}개</span></a></li>
            ))}
          </ul>
        ) : (
          <p>글이 공개되면 카테고리가 표시됩니다.</p>
        )}
        <a href="/categories">전체 카테고리 →</a>
      </section>
      <section class="sidebar-section">
        <h2>블로그 소개</h2>
        <p>특정 주제에 한정하지 않고, 오래 남기고 싶은 생각과 경험을 기록합니다.</p>
        <a href="/about">소개 보기 →</a>
      </section>
    </aside>
  </div>
</BaseLayout>
