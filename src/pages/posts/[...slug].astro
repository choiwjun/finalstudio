---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostFacts from '../../components/PostFacts.astro';
import PostToc from '../../components/PostToc.astro';
import { getPublicPosts, isPublicPost, type Post } from '../../lib/posts';
import { categoryPath, formatKoDate, sourceMeta, toIsoDate, topicBadgeClass, topicLabel } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter((post) => isPublicPost(post)).map((post) => ({
    // Astro 7 콘텐츠 레이어는 slug 대신 id(파일 경로 기반 슬러그)를 노출한다.
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const data = post.data;
const canonical = data.canonical;
const publicPosts = await getPublicPosts();
const relatedPosts = publicPosts
  .filter((candidate) => candidate.id !== post.id && (data.series ? candidate.data.series === data.series : candidate.data.topic === data.topic))
  .slice(0, 3);
const seriesPosts = data.series
  ? publicPosts
    .filter((candidate) => candidate.data.series === data.series)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((candidate) => candidate.id === post.id);
const previousPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextPost = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;
// pubDate가 미래인 카드는 색인 전에 배포될 수 있으므로 noindex로 보호한다.
const noindex = data.pubDate.getTime() > Date.now();

const siteUrl = import.meta.env.SITE ?? Astro.site?.toString() ?? 'http://localhost:4321';
const pageUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const coverUrl = data.image ? new URL(data.image, siteUrl).toString() : undefined;
const toolVersionEntries = Object.entries(data.toolVersions);
const body = (post as Post & { body?: string }).body ?? '';
const readMinutes = Math.max(1, Math.ceil(body.replace(/\s/g, '').length / 700));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  inLanguage: 'ko',
  url: pageUrl,
  ...(coverUrl ? { image: coverUrl } : {}),
  // 예약 공개 시각(publishAt)이 아니라 실제 작성·배포 시각 기준 (DeepSeek 4.3)
  datePublished: toIsoDate(data.pubDate),
  ...(data.testedAt ? { dateModified: toIsoDate(data.testedAt) } : {}),
  author: { '@type': 'Person', name: data.author },
  publisher: { '@type': 'Organization', name: 'WJ Blog', url: new URL('/', siteUrl).toString() },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '글 목록', item: new URL('/', siteUrl).toString() },
    { '@type': 'ListItem', position: 2, name: data.title },
  ],
};
---
<BaseLayout
  title={`${data.title} | WJ Blog`}
  description={data.description}
  canonical={canonical}
  ogType="article"
  ogImage={data.image}
  noindex={noindex}
  jsonLd={[jsonLd, breadcrumbs]}
>
  <div class="post-layout">
    <article class="article">
    <nav class="breadcrumbs" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">/</span><a href={categoryPath(data.topic)}>{topicLabel(data.topic)}</a><span aria-hidden="true">/</span><span>{data.title}</span>
    </nav>
    <header class="post-header">
      <p class="post-badges">
        <span class={topicBadgeClass(data.topic)}>{topicLabel(data.topic)}</span>
        {data.testedAt && <span class="badge badge--verified">직접 테스트</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="byline">
        <a href="/author">{data.author}</a>
        · <time datetime={toIsoDate(data.pubDate)}>{formatKoDate(data.pubDate)} 작성</time>
        {data.testedAt && (
          <> · <time datetime={toIsoDate(data.testedAt)}>{formatKoDate(data.testedAt)} 직접 확인</time></>
        )}
      </p>
      <p class="lede">{data.description}</p>
    </header>
    <section class="post-quick-answer" aria-labelledby="quick-answer-heading">
      <p class="eyebrow">빠른 답변</p>
      <h2 id="quick-answer-heading">이 글에서 바로 확인할 내용</h2>
      <p>{data.description}</p>
    </section>
    <PostFacts data={data} readMinutes={readMinutes} toolVersionEntries={toolVersionEntries} />
    <PostToc headings={headings} mobile />
    {data.image && (
      <img class="post-cover" src={data.image} alt="" width="1536" height="1024" loading="eager" decoding="async" />
    )}
    <div class="post-body"><Content /></div>
    {(data.testedAt || toolVersionEntries.length > 0 || data.sourceIds.length > 0) && (
      <section class="meta-panel" aria-labelledby="post-meta-heading">
        <h2 id="post-meta-heading">테스트 정보</h2>
        <dl>
          {data.testedAt && (
            <>
              <dt>직접 테스트</dt>
              <dd><time datetime={toIsoDate(data.testedAt)}>{formatKoDate(data.testedAt)}</time></dd>
            </>
          )}
          {toolVersionEntries.length > 0 && (
            <>
              <dt>도구 버전</dt>
              <dd>
                <ul>
                  {toolVersionEntries.map(([tool, version]) => <li><code>{tool}</code>: {version}</li>)}
                </ul>
              </dd>
            </>
          )}
          {data.sourceIds.length > 0 && (
            <>
              <dt>출처·확인</dt>
              <dd>
                <ul>
                  {data.sourceIds.map((source) => {
                    const meta = sourceMeta(source);
                    return <li>{meta.url ? <a href={meta.url} rel="nofollow noopener">{meta.label}</a> : <span>{meta.label}</span>}</li>;
                  })}
                </ul>
                {data.testedAt && <span>확인일: <time datetime={toIsoDate(data.testedAt)}>{formatKoDate(data.testedAt)}</time></span>}
              </dd>
            </>
          )}
        </dl>
        {data.aiAssisted && (
          <p class="meta-note">이 글은 AI의 도움으로 초안을 작성했고, 사람이 직접 실행하고 검토해 확인했습니다.</p>
        )}
      </section>
    )}
    <p class="post-backlink"><a href={categoryPath(data.topic)}>← {topicLabel(data.topic)} 글 목록</a></p>
    </article>
    <aside class="post-aside" aria-label="글 보조 정보">
      <PostToc headings={headings} />
      <div class="post-aside-block">
        <p class="aside-label">이 글의 상태</p>
        <p class="post-aside-title">{data.testedAt ? '직접 테스트한 글' : '검토 중인 글'}</p>
        <p>{data.testedAt ? '작성 화면과 결과를 직접 확인했습니다.' : '사람 검토를 마친 뒤 공개됩니다.'}</p>
      </div>
      <div class="post-aside-block">
        <p class="aside-label">{data.series ? `${data.series} 시리즈` : '다음 읽을거리'}</p>
        {relatedPosts.length ? (
          <ul class="aside-related-list">
            {relatedPosts.map((related) => <li><a href={`/posts/${related.id}`}>{related.data.title}</a></li>)}
          </ul>
        ) : (
          <p>같은 주제의 글이 더 쌓이면 이곳에서 이어집니다.</p>
        )}
      </div>
    </aside>
  </div>
  {(previousPost || nextPost) && (
    <nav class="post-series-nav" aria-label="시리즈 탐색">
      {previousPost ? <a href={`/posts/${previousPost.id}`}><span>이전 글</span><strong>{previousPost.data.title}</strong></a> : <span />}
      {nextPost ? <a href={`/posts/${nextPost.id}`}><span>다음 글</span><strong>{nextPost.data.title}</strong></a> : <span />}
    </nav>
  )}
</BaseLayout>
