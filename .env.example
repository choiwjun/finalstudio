# Set this only when a real domain has been approved.
PUBLIC_SITE_URL=https://example.com

# Required only for `npm run keywords:auto-publish -- --publish`.
# Use a secret, authenticated deploy hook from the hosting provider.
DEPLOY_HOOK_URL=

# NAVER API HUB keyword collection (optional; fixture and dry-run modes need no credentials).
# Keep values local and never commit real credentials.
NCP_NAVER_API_HUB_CLIENT_ID=
NCP_NAVER_API_HUB_CLIENT_SECRET=

# 자동 글발행 (npm run auto:write)
# ChatGPT OAuth로 로그인한 Codex CLI만 사용합니다. API 키는 필요하지 않습니다.
# 사전 준비: npm install -g @openai/codex && codex login
AUTO_ENGINE=codex
# CODEX_MODEL=

# 이미지(썸네일) 생성 (npm run image)
# Codex 세션에서 $imagegen으로 생성하거나 ChatGPT Images에서 생성한 파일을 --attach로 등록합니다.
# IMAGE_ENGINE=codex
