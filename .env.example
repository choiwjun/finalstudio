# Set this only when a real domain has been approved.
PUBLIC_SITE_URL=https://example.com

# 자동 글발행 (npm run auto:write)
# 엔진 선택: API 키가 있으면 api, 없으면 codex(ChatGPT 구독 OAuth)가 기본.
# 둘 다 없으면 수동 모드(ChatGPT 붙여넣기)로 안내됩니다.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AUTO_MODEL=gpt-4o-mini

# codex 엔진 (ChatGPT 구독 OAuth — API 과금 없음)
# 사전 준비: npm install -g @openai/codex && codex login (브라우저에서 ChatGPT 계정 로그인)
# AUTO_ENGINE=codex
# CODEX_MODEL=

# 이미지(썸네일) 생성 (npm run image)
# API 자동 생성: OPENAI_API_KEY 필요, 장당 약 $0.02~0.07 (gpt-image-1 medium 기준)
# 키가 없으면 ChatGPT 수동 생성용 프롬프트를 출력합니다.
# IMAGES_MODEL=gpt-image-1
# IMAGES_QUALITY=medium
